# Copy as .env. Replace local-only development passwords before use.
APP_ENV=development
API_PORT=3001
WEB_PORT=5173
LOG_LEVEL=info
ALLOWED_ORIGIN=http://localhost:5173
POSTGRES_PASSWORD=replace-with-unique-local-only-password
DATABASE_URL=postgresql://peopleops:replace-with-unique-local-only-password@127.0.0.1:5433/peopleops_dev
TEST_DATABASE_URL=postgresql://peopleops:replace-with-unique-local-only-password@127.0.0.1:5433/peopleops_test
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
