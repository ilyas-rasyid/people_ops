{
  "name": "@peopleops/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "build": "bun run db:generate && bun run typecheck && bun build ./src/index.ts --target bun --outdir dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "bun --env-file=../../.env dist/index.js",
    "db:generate": "bunx --bun prisma generate --config prisma7.config.ts",
    "db:migrate": "bunx --bun prisma migrate dev --config prisma7.config.ts",
    "db:deploy": "bunx --bun prisma migrate deploy --config prisma7.config.ts",
    "db:seed": "bun --env-file=../../.env run src/database/seed.ts",
    "db:provision": "bun --env-file=../../.env run src/database/provision-annual.ts",
    "db:constraints": "bun --env-file=../../.env run src/database/apply-constraints.ts"
  },
  "dependencies": {
    "@peopleops/contracts": "workspace:*",
    "elysia": "1.4.29",
    "pg": "8.23.0",
    "dotenv": "17.4.2",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/pg": "8.23.1"
  }
}
